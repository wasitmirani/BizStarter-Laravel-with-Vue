{
  "id": "/",
  "name": "LarabaseKit Admin",
  "short_name": "LarabaseAdmin",
  "description": "LarabaseKit admin dashboard — order and warehouse management.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/app",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
